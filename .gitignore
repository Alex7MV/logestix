# ── CMake Build Directories ──────────────────────────────────────────────────
/build/
/build_*/
/out/

# ── CTest Artifacts ──────────────────────────────────────────────────────────
/Testing/

# ── MSVC / Visual Studio Artifacts ───────────────────────────────────────────
.vs/
*.user
*.suo
*.sln
*.vcxproj
*.filters
*.dir/
*.log
*.tlog
*.pdb

# ── Compiled Binaries and Objects ────────────────────────────────────────────
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib
*.exe

# ── NVIDIA CCCL / CUDA Cache Artifacts ────────────────────────────────────────
*.i
*.ii
*.gpu
*.ptx
*.cubin
*.fatbin
