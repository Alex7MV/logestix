/build/include/lsxfabric/version.h

# ── IDE & Editor Specifics ────────────────────────────────────────────────────
.vscode/
.idea/
CMakeSettings.json
CMakeUserPresets.json
*.swp
*~
.DS_Store

# Dear ImGui runtime layout
imgui.ini

# Python bytecode (capture scripts import each other)
__pycache__/
*.pyc

# Stage-0/8 capture venvs (tools/granite_switch_oracle.py documents .venv-gs;
# a checkpoint oracle needs packages transformers cannot pin for the host).
.venv-gs/

# superpowers plan-execution scratch (ledger, briefs, review packages)
.superpowers/
