{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows 11 (VS 2026) - Debug",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-debug",
      "cacheVariables": {
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows 11 (VS 2026) - Release",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Ubuntu 26.04 (Ninja/GCC) - Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Ubuntu 26.04 (Ninja/GCC) - Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-release-znver4",
      "displayName": "Ubuntu 26.04 (Ninja) - Release, EPYC 9V74 (Zen 4, 160t)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release-znver4",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "LSX_ARCH_ZNVER4": "ON",
        "LSX_LTO": "ON"
      }
    },
    {
      "name": "linux-release-znver4-aocc",
      "displayName": "Ubuntu 26.04 (Ninja/AOCC clang 17) - Release, EPYC 9V74 (Zen 4, 160t)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release-znver4-aocc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "LSX_ARCH_ZNVER4": "ON",
        "LSX_LTO": "ON",
        "CMAKE_CXX_COMPILER": "$env{HOME}/projects/amd/aocc-compiler-5.2.0/bin/clang++",
        "CMAKE_C_COMPILER": "$env{HOME}/projects/amd/aocc-compiler-5.2.0/bin/clang",
        "CMAKE_CUDA_HOST_COMPILER": "$env{HOME}/projects/amd/aocc-compiler-5.2.0/bin/clang++",
        "CMAKE_BUILD_WITH_INSTALL_RPATH": "ON",
        "CMAKE_INSTALL_RPATH": "$ORIGIN/../_deps/arrow-build/release;$ORIGIN/../../_deps/arrow-build/release;$ORIGIN/../../../_deps/arrow-build/release",
        "CMAKE_CXX_FLAGS_RELEASE": "-DNDEBUG"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "linux-debug",
