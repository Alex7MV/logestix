{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },

  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows 11 (VS 2026) - Debug",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-debug",
      "cacheVariables": {
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows 11 (VS 2026) - Release",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Ubuntu 26.04 (Ninja/GCC) - Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Ubuntu 26.04 (Ninja/GCC) - Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-release-znver4",
      "displayName": "Ubuntu 26.04 (Ninja) - Release, EPYC 9V74 (Zen 4, 160t)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release-znver4",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "LSX_ARCH_ZNVER4": "ON",
        "LSX_LTO": "ON"
      }
    }
  ],

  "buildPresets": [
    { "name": "windows-debug",   "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "linux-debug",     "configurePreset": "linux-debug" },
    { "name": "linux-release",   "configurePreset": "linux-release" },
    { "name": "linux-release-znver4", "configurePreset": "linux-release-znver4", "jobs": 160 }
  ],

  "testPresets": [
    { "name": "windows-debug",   "configurePreset": "windows-debug",   "configuration": "Debug",   "output": { "outputOnFailure": true }, "filter": { "include": { "label": "^fast$" } } },
    { "name": "windows-debug-fast",      "configurePreset": "windows-debug",   "configuration": "Debug",   "output": { "outputOnFailure": true }, "filter": { "include": { "label": "^fast$" } } },
    { "name": "windows-debug-inference", "configurePreset": "windows-debug",   "configuration": "Debug",   "output": { "outputOnFailure": true }, "filter": { "include": { "label": "^inference$" } } },
    { "name": "windows-debug-perf",      "configurePreset": "windows-debug",   "configuration": "Debug",   "output": { "outputOnFailure": true }, "filter": { "include": { "label": "^perf$" } } },

    { "name": "windows-release",   "configurePreset": "windows-release",   "configuration": "Release",   "output": { "outputOnFailure": true }, "filter": { "include": { "label": "^fast$" } } },
    { "name": "windows-release-fast",      "configurePreset": "windows-release",   "configuration": "Release",   "output": { "outputOnFailure": true }, "filter": { "include": { "label": "^fast$" } } },
    { "name": "windows-release-inference", "configurePreset": "windows-release",   "configuration": "Release",   "output": { "outputOnFailure": true }, "filter": { "include": { "label": "^inference$" } } },
    { "name": "windows-release-perf",      "configurePreset": "windows-release",   "configuration": "Release",   "output": { "outputOnFailure": true }, "filter": { "include": { "label": "^perf$" } } },

    { "name": "linux-debug",   "configurePreset": "linux-debug",   "output": { "outputOnFailure": true }, "filter": { "include": { "label": "^fast$" } } },
    { "name": "linux-debug-fast",      "configurePreset": "linux-debug",   "output": { "outputOnFailure": true }, "filter": { "include": { "label": "^fast$" } } },
    { "name": "linux-debug-inference", "configurePreset": "linux-debug",   "output": { "outputOnFailure": true }, "filter": { "include": { "label": "^inference$" } } },
    { "name": "linux-debug-perf",      "configurePreset": "linux-debug",   "output": { "outputOnFailure": true }, "filter": { "include": { "label": "^perf$" } } },

    { "name": "linux-release",   "configurePreset": "linux-release",   "output": { "outputOnFailure": true }, "filter": { "include": { "label": "^fast$" } } },
    { "name": "linux-release-fast",      "configurePreset": "linux-release",   "output": { "outputOnFailure": true }, "filter": { "include": { "label": "^fast$" } } },
    { "name": "linux-release-inference", "configurePreset": "linux-release",   "output": { "outputOnFailure": true }, "filter": { "include": { "label": "^inference$" } } },
    { "name": "linux-release-perf",      "configurePreset": "linux-release",   "output": { "outputOnFailure": true }, "filter": { "include": { "label": "^perf$" } } },

    { "name": "linux-release-znver4",   "configurePreset": "linux-release-znver4",   "output": { "outputOnFailure": true }, "filter": { "include": { "label": "^fast$" } } },
    { "name": "linux-release-znver4-fast",      "configurePreset": "linux-release-znver4",   "output": { "outputOnFailure": true }, "filter": { "include": { "label": "^fast$" } } },
    { "name": "linux-release-znver4-inference", "configurePreset": "linux-release-znver4",   "output": { "outputOnFailure": true }, "filter": { "include": { "label": "^inference$" } } },
    { "name": "linux-release-znver4-perf",      "configurePreset": "linux-release-znver4",   "output": { "outputOnFailure": true }, "filter": { "include": { "label": "^perf$" } } }
  ]
}